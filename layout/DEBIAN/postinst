#!/bin/sh
set -e

# Imported packs live outside the package so they survive updates and can be
# written by the Settings app, which runs as mobile.
# RootHide bootstrap commands resolve these paths inside jbroot (vroot).
# Keep this in sync with FC_DATA_PATH in FlexClockPaths.h; do not add /var/jb.
PACKS=/var/mobile/Library/FlexClock/Packs
mkdir -p "$PACKS"
chown -R mobile:mobile /var/mobile/Library/FlexClock

exit 0
